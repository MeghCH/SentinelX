# Surcharges OPTIONNELLES des identifiants pour la stack consolidée.
# Sans fichier `.env`, tout démarre avec les identifiants par défaut du labo.
# Pour surcharger : cp .env.example .env puis éditer les valeurs.

# Wazuh (detection/wazuh/docker-compose.wazuh.yml)
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_DASHBOARD_USER=admin
WAZUH_DASHBOARD_PASSWORD=SecretPassword

# Grafana (docker-compose.yml racine)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
